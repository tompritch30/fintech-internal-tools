{
  "name": "fintech-internal-tools",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @fit/web dev",
    "build": "pnpm --filter @fit/web build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @fit/web test:e2e",
    "db:generate": "pnpm --filter @fit/db generate",
    "db:migrate": "pnpm --filter @fit/db migrate",
    "db:seed": "pnpm --filter @fit/db seed"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9.39.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.60.0",
    "vitest": "^5.0.0"
  }
}
