# Local development only. Every value here is a fake demo value. Copy to .env for `pnpm dev`.
# docker compose sets its own values (see docker-compose.yml); keep both in sync.

# Public URL of the web app (used for OIDC redirect URIs and cookies)
APP_URL=http://localhost:3000

# Runtime DB role: SELECT/INSERT only on audit_log
DATABASE_URL=postgres://app_runtime:demo-only-change-me@localhost:5432/internal_tools
# Owner role: migrations and seed only, never used by the app at runtime
DATABASE_OWNER_URL=postgres://app_owner:demo-only-change-me@localhost:5432/internal_tools

# Tests (defaults shown; override only if your Postgres differs)
TEST_DATABASE_URL=postgres://app_runtime:demo-only-change-me@localhost:5432/internal_tools_test
TEST_DATABASE_OWNER_URL=postgres://app_owner:demo-only-change-me@localhost:5432/internal_tools_test

# OIDC. Keycloak locally; Entra ID in production by changing these values only:
#   OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=http://localhost:8080/realms/internal-tools
# Only needed when the app reaches the IdP on a different host than the browser (docker compose)
OIDC_INTERNAL_ISSUER=
OIDC_CLIENT_ID=internal-tools-web
OIDC_CLIENT_SECRET=demo-only-change-me
OIDC_ROLES_CLAIM=roles
# Allows http:// issuers. Local only: leave unset in any real environment.
OIDC_ALLOW_INSECURE_HTTP=true

SESSION_TTL_HOURS=8
# Session idle timeout in minutes before the user must sign in again
SESSION_IDLE_MINUTES=15
# Maximum number of unmask operations per user per hour
UNMASK_RATE_LIMIT_PER_HOUR=20

# Refunds app: refunds above this many pence need approval from a different approver (25000 = £250.00)
REFUND_APPROVAL_THRESHOLD_PENCE=25000

# KYC app: closed cases are retained (no delete) for this many years after closing.
# Default 5 (UK MLR 2017 reg. 40, research S11/S12); values below 5 are refused at startup.
KYC_RETENTION_YEARS=5

# Feature flags app: bearer token services send to GET /api/flags?environment=prod (read-only).
# Empty (the default) switches the endpoint off (503). To try it locally, set a random value of
# at least 16 characters, e.g. `openssl rand -hex 24`. Never commit a real value.
FLAGS_SERVICE_TOKEN=

# Containers (docker compose)
POSTGRES_PASSWORD=demo-only-change-me
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=demo-only-change-me

# E2E: set to test an already-running app instead of starting one
E2E_BASE_URL=
